export default async function TaskDetail({params}:{params:Promise<{id:string}>}) {
  const {id}=await params;
  if(!taskId.safeParse(id).success) notFound();
  const {configured,detail,signedIn}=await getDetail(id);
  if(!configured) return <section className="directory-state"><h2>Task instructions are not available yet.</h2><p>The task connection has not been configured. Please check back soon.</p><Link className="button secondary" href="/opportunities">Back to opportunities</Link></section>;
  if(!detail) notFound();
  return <article className="task-detail"><Link className="back-link" href="/opportunities">← Back to opportunities</Link><div className="task-title"><div className="opportunity-meta"><span className={`difficulty difficulty-${detail.difficulty}`}>{label(detail.difficulty)}</span><span>{label(detail.contribution_type)}</span></div><h1>{detail.title}</h1><p>{detail.summary}</p><ul className="skill-tags" aria-label="Required skills">{detail.skills.map((skill,index)=><li key={`${index}-${skill}`}>{skill}</li>)}</ul></div>{detail.status==="archived" && <p className="archive-note" role="status">This task is archived. You started it before archival and can continue using these instructions. Check the source issue before doing more work.</p>}<div className="task-columns"><div><section className="instruction-section"><h2>Before you start</h2><p className="instruction-text">{detail.prerequisites||"No additional prerequisites have been listed. Read the project’s contribution guidelines first."}</p></section><section className="instruction-section"><h2>Set up the project</h2><p className="instruction-text">{detail.setup_notes}</p></section><section className="instruction-section"><h2>Project links</h2><div className="actions"><a className="button secondary" href={detail.repository_url} target="_blank" rel="noopener noreferrer">Open repository ↗</a><a className="button secondary" href={detail.issue_url} target="_blank" rel="noopener noreferrer">Open source issue ↗</a></div><p className="field-hint">Links open in a new tab. Check the contribution guidelines and current issue availability before starting.</p></section></div><section className="checklist-panel" aria-labelledby="checklist-title"><h2 id="checklist-title">Your contribution checklist</h2>{!detail.steps.length && <p>No checklist steps have been added to this task yet.</p>}{!signedIn ? <><p>Sign in to start this task and save your own progress.</p><Link className="button primary" href="/sign-in">Sign in to save progress</Link><ol className="checklist-preview">{detail.steps.map(step=><li key={step.id}>{step.label}</li>)}</ol></> : !detail.started ? <><p>Start this task when you’re ready. Your progress stays separate from everyone else’s.</p><StartTask id={detail.id}/><ol className="checklist-preview">{detail.steps.map(step=><li key={step.id}>{step.label}</li>)}</ol></> : <TaskChecklist detail={detail}/>}</section></div><section className="instruction-section"><h2>Stuck on this task?</h2><p>Describe a blocker in a private help request. Authorized mentors can send guidance through your request history.</p><Link className="button secondary" href={signedIn ? `/help/new?opportunity=${detail.id}` : "/sign-in"}>{signedIn ? "Request help" : "Sign in to request help"}</Link></section><section className="instruction-section"><h2>Ready to share your contribution?</h2><p>Record your GitHub PR link. A curator will review its status manually.</p><Link className="button primary" href={signedIn ? `/contributions/new?opportunity=${detail.id}` : "/sign-in"}>{signedIn ? "Submit a pull request" : "Sign in to submit a PR"}</Link></section></article>;
}
