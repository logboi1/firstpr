{
  "name": "firstpr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:db": "node --test tests/database/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:auth && npm run test:directory && npm run test:db && npm run build",
    "github:setup": "node scripts/setup-github.mjs",
    "test:auth": "node --experimental-strip-types --test tests/auth/*.test.mjs",
    "test:e2e": "playwright test",
    "test:directory": "node --experimental-strip-types --test tests/directory/*.test.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.1",
    "pg": "^8.23.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
