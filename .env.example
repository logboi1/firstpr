# Copy to .env.local and configure a development Supabase project.
# See docs/AUTHENTICATION.md for email-code templates and migrations.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server-only credential for higher GitHub public API rate limits.
# Use a fine-grained token with public read-only access; never NEXT_PUBLIC_.
# Without this, public PR checks use GitHub's unauthenticated rate limit.
GITHUB_PUBLIC_READ_TOKEN=
